# ==============================================================================
# BEAST ROAD — Godot 4.7
# ==============================================================================

# ------------------------------------------------------------------------------
# Godot's import and script cache.
#
# Godot 4 keeps everything derived in one folder and regenerates it on open.
# This is the Godot 4 equivalent of Godot 3's `.import/` — the name and the
# location both changed, so do not copy a Godot 3 .gitignore into a 4.x project.
# ------------------------------------------------------------------------------
.godot/

# ------------------------------------------------------------------------------
# Deliberately NOT ignored — do not "clean these up":
#
#   *.import   sits next to each asset and holds its import settings and its
#              uid://. Dropping it means every clone re-imports with fresh UIDs
#              and any scene referencing the old one has to fall back to a path.
#   *.uid      the Godot 4.4+ equivalent for scripts. Same reasoning.
#
# Both are source, not cache, however much they look generated.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# The engine itself. A 180 MB download, not project source.
# The trailing slash matters: this is a folder whose name ends in .exe.
# ------------------------------------------------------------------------------
Godot_v*-stable_win64.exe/

# ------------------------------------------------------------------------------
# Art staging. Drop generated PNGs here and run tools\import_art.ps1; the
# importer files them into game/art/, which IS committed. The inbox itself is
# scratch space and would otherwise double the repo size with source images.
# ------------------------------------------------------------------------------
art_inbox/
game/.automated_checks/

# ------------------------------------------------------------------------------
# Builds and exports
# ------------------------------------------------------------------------------
build/
builds/
export/
exports/
*.pck
*.zip

# Export presets can hold keystore paths and passwords. Godot 4 splits the
# secrets into their own file; that one never gets committed.
export_credentials.cfg

# **Signing keys, wherever somebody puts them.**
#
# The Android release key is permanent - every future update must be signed with
# the same one or Android refuses to install over the existing app - and a key in
# a public repository is a key anybody can sign a fake Beast Road with. It was
# briefly sitting untracked in APK_Secrets/, one `git add -A` away from being
# published, which is why this matches by extension as well as by folder: the
# next person will put it somewhere else.
APK_Secrets/
*.keystore
*.jks
*.b64
keystore*



# ------------------------------------------------------------------------------
# Android / iOS build templates, only present if a mobile export is set up
# ------------------------------------------------------------------------------
game/android/
game/ios/

# ------------------------------------------------------------------------------
# Editors and OS cruft
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Isolated user:// profiles created by local headless validation. They keep test
# logs and screenshots away from the player's real save directory.
.codex-godot-*/
.codex-launcher-*/

# Pixellab's raw per-frame export. 648 PNGs for the hero alone, and the packed
# sheets in game/art/hero/ are what the game loads. Kept out of the repo so the
# clone stays small; re-pack with tools/pack_hero_frames.py.
art_inbox/Pixellab/
