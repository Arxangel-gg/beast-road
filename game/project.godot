; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beast Road"
config/description="A 2D action tower-defense roguelite. One hero, four lanes, can't be everywhere."
run/main_scene="res://scenes/ui/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Balance="*res://scripts/Balance.gd"
EventBus="*res://autoload/EventBus.gd"
ContentDB="*res://autoload/ContentDB.gd"
MetaState="*res://autoload/MetaState.gd"
RunState="*res://autoload/RunState.gd"
Modifiers="*res://autoload/Modifiers.gd"
Vfx="*res://autoload/Vfx.gd"
GameDirector="*res://autoload/GameDirector.gd"
MusicPlayer="*res://autoload/MusicPlayer.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui_theme.tres"

