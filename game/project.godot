; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beast Road"
config/description="A 2D action tower-defense roguelite. One hero, four lanes, can't be everywhere."
run/main_scene="res://scenes/ui/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Balance="*res://scripts/Balance.gd"
EventBus="*res://autoload/EventBus.gd"
ContentDB="*res://autoload/ContentDB.gd"
MetaState="*res://autoload/MetaState.gd"
RunState="*res://autoload/RunState.gd"
Modifiers="*res://autoload/Modifiers.gd"
DayNight="*res://autoload/DayNight.gd"
Vfx="*res://autoload/Vfx.gd"
GameDirector="*res://autoload/GameDirector.gd"
MusicPlayer="*res://autoload/MusicPlayer.gd"
Sfx="*res://autoload/Sfx.gd"
Ambience="*res://autoload/Ambience.gd"
UiSound="*res://autoload/UiSound.gd"
Leaderboard="*res://autoload/Leaderboard.gd"
Coop="*res://autoload/Coop.gd"
ScreenFit="*res://autoload/ScreenFit.gd"
TouchInput="*res://autoload/TouchInput.gd"
MilestoneCinematics="*res://autoload/MilestoneCinematics.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
; Windowed on the web, where "the window" is a canvas in someone else's page.
;
; Mode 3 is fullscreen, and the engine applies it at boot before any script
; runs - so the web build opened by asking for fullscreen and being refused,
; because a browser only grants it from inside a user gesture. The console said
; so on every load. A feature-tagged override is the only place this can be
; fixed; UserSettings.apply_display() runs far too late to prevent it.
window/size/mode.web=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui_theme.tres"

