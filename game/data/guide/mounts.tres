[resource]
script = ExtResource("1_s")
id = "mounts"
display_name = "Mounts and the stable"
title = "Mounts and the stable"
category = "Basics"
order = 18
image = "res://art/guide/mounts.png"
body = "A mount is something to cross ground on, and nothing else. Halric keeps four at the Hold's stable and sells them for Marks. Mounted, you cannot swing, cast, loose, gather, fish or take an egg - and the first press of attack puts you on your feet where you stood, so the fight starts where you dismounted. A gallop outruns your own legs, and it spends your SP to do it - each mount at its own rate, so a courser burns through a pool a marsh pony would still be carrying. Spend it all and you arrive winded. Press H, or Ride on the action bar. You will not mount with something hostile close by, and deep water takes you off."
