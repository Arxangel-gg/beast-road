script = ExtResource("1_s")
id = "coop"
display_name = "Playing together"
title = "Playing together"
category = "Co-op"
order = 32
image = "res://art/guide/coop.png"
body = "Two to four Wardens, one beast. The host's world is the one that counts; everyone else sees it. Roads are voted on; relics, portents and cards are one choice for the party. Co-op unlocks after your first road reaches a crossroad."
