script = ExtResource("1_s")
id = "stash"
display_name = "The stash"
title = "The stash"
category = "Items & Gear"
order = 24
image = "res://art/guide/stash.png"
body = "The stash holds your gear between runs. Wear three pieces; break the rest for Shards or sell them for Marks. Mark a piece kept and the break-all buttons leave it alone. The pantry tab holds your fish."
