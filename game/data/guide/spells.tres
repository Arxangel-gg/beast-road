id = "spells"
display_name = "Spells and mana"
title = "Spells and mana"
category = "Fighting"
order = 6
image = "res://art/guide/spells.png"
body = "Spells cost mana, which refills slowly. Focus deepens the pool and sharpens the spells. Ranged spells strike where you point, after a delay you can see: the ring on the ground is exactly where and when the blow lands."
