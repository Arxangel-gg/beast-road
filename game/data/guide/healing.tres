[resource]
script = ExtResource("1_s")
id = "healing"
display_name = "Staying alive"
title = "Staying alive"
category = "Healing"
order = 19
image = "res://art/guide/healing.png"
body = "Health does not come back on its own. Tend the Warden in Preparation for Food; drink from a Healing Well you built by walking to it and pressing Interact when it is full; eat a fish; pick up the orbs some enemies drop. Wounds are the run's lives: three, and the fourth death ends the road."
