script = ExtResource("1_s")
id = "night"
display_name = "Night"
title = "Night"
category = "Fighting"
order = 5
image = "res://art/guide/night.png"
body = "The sky follows the distance walked. At night the waves are larger and harder; torches on the roads keep them lit, and a dark road is a slower, meaner road. The sundial on the HUD tells you how long until dark."
