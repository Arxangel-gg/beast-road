script = ExtResource("1_s")
id = "depth"
display_name = "Depth and the bubbles"
title = "Depth and the bubbles"
category = "Fishing & Water"
order = 16
image = "res://art/guide/depth.png"
body = "The middle of a pond is deep and the rare fish live there; they fight harder. Bubbles mark something below: cast into them for a better chance at a rare catch, or a chance of startling it off. Swim over them and it may bite you."
