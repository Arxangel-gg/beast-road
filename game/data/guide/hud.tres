script = ExtResource("1_s")
id = "hud"
display_name = "Reading the screen"
title = "Reading the screen"
category = "Basics"
order = 3
image = "res://art/guide/hud.png"
body = "Top left: act, level, weather, the four currencies and how far to the next crossroad. The sundial beside them is the time of day - the sun sets where the moon rises. Top centre: the boss tracker. Right: the town's health, your health, Wounds. Bottom: your actions and spells."
