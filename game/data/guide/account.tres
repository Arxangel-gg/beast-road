script = ExtResource("1_s")
id = "account"
display_name = "Marks and Shards"
title = "Marks and Shards"
category = "Resources"
order = 22
image = "res://art/guide/account.png"
body = "Marks and Shards are account currencies: they survive runs and buy from the stash and the Ledger. They never exchange with the run's four, so a stash purchase can never compete with the wall about to be overrun."
