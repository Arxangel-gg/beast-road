[resource]
script = ExtResource("1_s")
id = "sandbox"
display_name = "The sandbox"
title = "The sandbox"
category = "The Road"
order = 67
image = "res://art/guide/sandbox.png"
body = "A sandbox road is every tower, a purse nothing on the board can empty, and any act you like - opened from the Hold, alone. Build whatever you want to try, on whichever battlefield the settings deal. Nothing you earn, find, unlock or lose on it is kept: your Warden is exactly as they were when you come back, and a sandbox road is never posted to the board."
