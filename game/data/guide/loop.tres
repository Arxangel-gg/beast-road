[resource]
script = ExtResource("1_s")
id = "loop"
display_name = "The loop"
title = "The loop"
category = "Basics"
order = 0
image = "res://art/guide/loop.png"
body = "Yuri walks. Between stretches of road the game pauses in Preparation: build towers on the roads, repair, tend the Warden, then Ride On. A wave arrives from the roads, you hold it, and the beast walks again. Crossroads offer a choice of road and a Road Card; the act ends when its boss falls. Ten acts, then the summit."
