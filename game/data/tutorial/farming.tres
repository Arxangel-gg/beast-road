script = ExtResource("1_step")
id = "farming"
display_name = "A crop"
trigger = 19
order = 0
body = "A crop, out on the outskirts. Take a wild one's seeds and plant them in a bare plot; the crop grows as the beast walks, on ground that suits it. A plant that droops and browns is telling you the ground is wrong - warmer, wetter, colder, drier - and a practised Farmer gets more from the same ground."
seconds = 12.0
