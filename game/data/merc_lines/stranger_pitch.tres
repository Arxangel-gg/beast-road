[resource]
script = ExtResource("1")
lines = PackedStringArray("Looking for a blade? I come cheaper than a funeral.", "I walk the roads for coin. You look like you have some.", "Hire me and I'll keep them off your back.", "I've seen the Terrace and come back. Can your last hire say that?", "Coin first. Then I fight like I mean it.")
