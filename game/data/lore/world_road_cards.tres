[ext_resource type="Script" path="res://scripts/resources/lore_entry_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "world_road_cards"
display_name = "Portents and the Arsenal"
title = "Portents and the Arsenal"
category = 0
unlock_act = 0
order = 6
art = ""
body = "When an act's boss falls, the road announces itself: three portents are offered and one is read, a bane and a boon kept for the rest of the run. And the road arms whoever walks it: every rank it grants deals three cards from the Arsenal - weapons that fight beside the Warden, catalysts that feed them, keystones that turn a rule - and one is kept. What the road gives, it gives for this road; none of it is carried home."
