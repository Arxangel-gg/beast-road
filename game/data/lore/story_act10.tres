[resource]
script = ExtResource("1_s")
id = "story_act10"
display_name = "Act 10  ·  The Last Terrace"
title = "Act 10  ·  The Last Terrace"
category = 1
unlock_act = 10
order = 10
art = ""
body = "Stone stairs to the sky, and one of Kharok's anchors standing on the top of them. He drove them into the earth to hold the roads still, and this is the last one between the road and the Crown - it has been up there longer than the stairs have. Past it is the beacon, and past the beacon is a world with no chain in it. Yuri stops here. This is where the walk was going."
