[resource]
script = ExtResource("1_s")
id = "story_act06"
display_name = "Act 6  ·  Salt Keeps Everything"
title = "Act 6  ·  Salt Keeps Everything"
category = 1
unlock_act = 6
order = 6
art = ""
body = "The Saltpan Mire is white to the horizon and it keeps what it takes. The Brine Choir sings the drowned back onto their feet, and the Brinefather has had a very long time to think about salt. Kill the singer, the Warden learns, and the song stops holding them together."
